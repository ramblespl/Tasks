rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserTemplates document
    function isValidUserTemplates(data, userId) {
      return data.keys().hasAll(['userId', 'templateSets', 'activeTemplateSetId']) &&
             data.keys().hasOnly(['userId', 'templateSets', 'activeTemplateSetId', 'updatedAt']) &&
             data.userId == userId &&
             data.activeTemplateSetId is string &&
             data.activeTemplateSetId.size() <= 128 &&
             data.templateSets is list &&
             data.templateSets.size() <= 50 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Test connection check document
    match /test/connection {
      allow read: if true;
    }

    // Synchronized user settings and templates (cross-device per Google account)
    match /users/{userId}/settings/{settingId} {
      allow get: if isValidId(userId) && isValidId(settingId);
      allow list: if isValidId(userId);
      allow create: if isValidId(userId) &&
                       isValidId(settingId) &&
                       isValidUserTemplates(incoming(), userId);
      allow update: if isValidId(userId) &&
                       isValidId(settingId) &&
                       isValidUserTemplates(incoming(), userId) &&
                       incoming().userId == existing().userId;
      allow delete: if isValidId(userId) && isValidId(settingId);
    }
  }
}
